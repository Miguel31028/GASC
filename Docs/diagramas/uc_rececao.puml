@startuml
!include _estilo.iuml
left to right direction
actor "Operador de\narmazém" as OP
rectangle "P1 Receção" {
  usecase "UC01 Registar receção" as R1
  usecase "Identificar doador\n(particular / empresa / anónimo)" as R2
  usecase "Registar linha de produto\n(quantidade, unidade, validade)" as R3
  usecase "Registar controlo de receção\n(C/NC, temperatura)" as R4
  usecase "Anexar guia de transporte\ndigitalizada" as R5
  usecase "Criar produto no catálogo" as R6
}
OP -- R1
R1 ..> R2 : <<include>>
R1 ..> R3 : <<include>>
R3 ..> R4 : <<include>>
R5 ..> R1 : <<extend>>\n[origem = empresa]
R6 ..> R3 : <<extend>>\n[produto inexistente]
@enduml
