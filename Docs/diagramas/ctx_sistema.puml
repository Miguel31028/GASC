@startuml
!include _estilo.iuml
left to right direction
actor "Doadores\n(particulares, empresas,\norganizações)" as DO
actor "Colaboradores\n(armazém, cozinha,\ntécnicos, responsável)" as CO
actor "Utentes e\nagregados" as UT
actor "Equipa HACCP /\nentidades externas" as HA
rectangle "Sistema de Gestão do\nEspaço Social (GASC)" as SIS
DO --> SIS : bens doados,\nguias de transporte
CO --> SIS : receções, arrumações,\nentregas, refeições
SIS --> CO : sugestões, alertas,\nindicadores
UT --> SIS : pedidos de refeição,\nidentificação (QR)
SIS --> UT : cabazes, refeições,\nagenda, credencial
SIS --> HA : RGDHSA049,\nrelatórios
@enduml
