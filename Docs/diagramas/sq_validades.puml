@startuml
!include _estilo.iuml
autonumber
participant "Cloud Scheduler" as SC
participant "Cloud Function\nverificarValidades" as CV
participant "Cloud Function\nfecharDia" as CD
database "Cloud Firestore" as FS
participant "Firebase Cloud\nMessaging" as FCM
actor "Operador /\nResponsável" as US

== Diariamente às 07:00 ==
SC -> CV : disparar
activate CV
CV -> FS : query lotes where estado in\n[PENDENTE_ARRUMACAO, DISPONIVEL, CONGELADO]\nand validade <= hoje + max(diasAviso)
FS --> CV : lotes
loop cada lote
  alt validade < hoje
    CV -> FS : lote.estado = EXPIRADO
    CV -> FS : alerta EXPIRADO (id: tipo+lote+data)
  else validade <= hoje + diasAviso(categoria)
    CV -> FS : alerta VALIDADE_PROXIMA (id: tipo+lote+data)
  end
end
CV -> FS : comparar produtos.stockAtual com stockMinimo
CV -> FS : alertas STOCK_MINIMO (id: tipo+produto+data)
CV -> FCM : notificação por tópico do perfil
deactivate CV
FCM --> US : notificação push
== Diariamente à hora de fecho (parâmetro) ==
SC -> CD : disparar
activate CD
CD -> FS : agendamentos de hoje AGENDADO → FALTOU
CD -> FS : serviços de hoje ainda abertos → fechar;\npedidos PEDIDO → NAO_LEVANTADO
deactivate CD
@enduml
