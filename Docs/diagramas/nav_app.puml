@startuml
!include _estilo.iuml
hide empty description
state "M01 Autenticação" as L
state "M02 Início (por perfil)" as H
state "Leitura global de QR" as Q
state "Receção" as R {
  state "M04 Origem e doador" as R1
  state "M05 Pesquisa / M06 Criar produto" as R2
  state "M07 Quantidade e validade" as R3
  state "M08 Controlo de receção" as R4
  state "M09 Resumo" as R5
  R1 --> R2
  R2 --> R3
  R3 --> R4
  R4 --> R2 : nova linha
  R4 --> R5
}
state "Arrumação" as A {
  state "M10 Lotes por arrumar" as A1
  state "M11 Sugestão de local" as A2
  state "M12 Leitura do QR" as A3
  A1 --> A2
  A2 --> A3
}
state "Stock" as S {
  state "M13 Consulta" as S1
  state "M14 Lotes (FEFO)" as S2
  state "M15 Congelar / M17 Desperdício" as S3
  S1 --> S2
  S2 --> S3
}
state "M16 Alertas" as AL
state "Entregas" as E {
  state "M22 Entregas do dia" as E1
  state "M23 Identificação" as E2
  state "M24 Cabaz / M26 Outros bens" as E3
  state "M25 Confirmação" as E4
  E1 --> E2
  E2 --> E3
  E3 --> E4
}
state "Refeições (M27–M30)" as M
state "M03 Mais" as MA
state "Utentes (M18–M21)" as U
state "Relatórios (M31–M33)" as RL
state "Administração (M34–M37)" as AD
[*] --> L
L --> H
H --> R
H --> S
H --> E
H --> AL
H --> Q
H --> MA
MA --> M
MA --> U
MA --> RL
MA --> AD
R5 --> A1 : lotes pendentes
AL --> S2
Q --> A3
Q --> E2
@enduml
