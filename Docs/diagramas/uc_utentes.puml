@startuml
!include _estilo.iuml
left to right direction
actor "Técnico de\nação social" as TEC
actor "Responsável\nda instituição" as RESP
actor "Utente" as UT
rectangle "P3 Utentes e Entregas: gestão de utentes" {
  usecase "UC05 Registar / editar agregado" as U1
  usecase "Gerir membros do agregado" as U2
  usecase "Definir pessoas autorizadas\na levantar" as U3
  usecase "Emitir credencial QR\n(papel / app)" as U4
  usecase "Registar consentimento RGPD" as U5
  usecase "Definir periodicidade\ndo cabaz" as P1
  usecase "Ativar conta na App Utente" as U6
  usecase "Consultar credencial QR" as U7
}
TEC -- U1
RESP -- U1
RESP -- P1
UT -- U7
U1 ..> U2 : <<include>>
U1 ..> U5 : <<include>>
U3 ..> U2 : <<extend>>
U4 ..> U3 : <<extend>>
U6 ..> U1 : <<extend>>
@enduml
