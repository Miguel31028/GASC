@startuml
!include _estilo.iuml
left to right direction
actor "Administrador" as ADM
actor "Responsável\nda instituição" as RESP
actor "Técnico de\nação social" as TEC
actor "Operador de\narmazém" as OP
actor "Cozinha" as COZ
actor "Utente" as UT
actor "Tempo" as TMP
rectangle "Sistema de Gestão do Espaço Social" {
  usecase "P1\nReceção" as P1
  usecase "P2\nArmazém e Stock" as P2
  usecase "P3\nUtentes e Entregas" as P3
  usecase "P4\nRefeições" as P4
  usecase "P5\nAdministração" as P5
  usecase "P6\nRelatórios e Alertas" as P6
}
OP -- P1
OP -- P2
OP -- P3
RESP -- P2
RESP -- P3
RESP -- P5
RESP -- P6
TEC -- P3
TEC -- P4
COZ -- P4
COZ -- P2
UT -- P3
UT -- P4
ADM -- P5
TMP -- P6
@enduml
