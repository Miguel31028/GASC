@startuml
!include _estilo.iuml
hide circle
skinparam classAttributeIconSize 0
class ServicoRefeicao {
  data : Date
  tipo : TipoRefeicao
  aberto : Boolean
  totalPrevisto : Int
  totalConfecionado : Int
  +fechar()
}
class PedidoRefeicao {
  id : String
  data : Date
  numeroRefeicoes : Int
  origem : OrigemPedido
  estado : EstadoPedido
  +cancelar()
}
class Levantamento {
  dataHora : Timestamp
  numeroEntregues : Int
  justificacaoExcecao : String
}
class SaidaCozinha {
  id : String
  dataHora : Timestamp
}
class LinhaSaida
class Agregado
class Pessoa
class Utilizador
Agregado "1" -- "0..*" PedidoRefeicao
PedidoRefeicao "0..*" -- "1" ServicoRefeicao
PedidoRefeicao "0..*" -- "0..1" Utilizador : registado por >
PedidoRefeicao "0..1" -- "0..*" Levantamento
Levantamento "0..*" -- "1" Pessoa : levantado por >
Levantamento "0..*" -- "1" Utilizador : entregue por >
ServicoRefeicao "1" -- "0..*" SaidaCozinha
SaidaCozinha "0..1" *-- "0..*" LinhaSaida
note right of PedidoRefeicao : data desnormalizada do serviço;\nregistado por um colaborador ou\npela conta do utente (origem APP_UTENTE)
@enduml
