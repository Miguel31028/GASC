@startuml
!include _estilo.iuml
left to right direction
actor "Operador de\narmazém" as OP
actor "Responsável\nda instituição" as RESP
actor "Cozinha" as COZ
rectangle "P2 Armazém e Stock" {
  usecase "UC02 Arrumar lote" as A1
  usecase "Sugerir localização" as A2
  usecase "Assinalar célula/zona cheia" as A3
  usecase "Transferir lote" as A5
  usecase "UC03 Congelar lote" as C1
  usecase "Propor nova validade\n(tabela da categoria)" as C2
  usecase "UC04 Registar desperdício" as D1
  usecase "Consultar stock e validades" as S1
  usecase "UC08 Registar saída\npara a cozinha" as K1
}
OP -- A1
OP -- A5
OP -- C1
OP -- D1
OP -- S1
RESP -- S1
RESP -- D1
COZ -- K1
COZ -- S1
A1 ..> A2 : <<include>>
A3 ..> A1 : <<extend>>\n[local cheio]
C1 ..> C2 : <<include>>
@enduml
