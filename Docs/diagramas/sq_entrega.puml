@startuml
!include _estilo.iuml
autonumber
actor "Operador" as OP
actor "Pessoa que\nlevanta" as PL
participant "App Android\n(UI Entrega)" as UI
participant "EntregaViewModel" as VM
participant "Cloud Functions\n(identificarPessoa,\nregistarEntrega)" as CF
database "Cloud Firestore" as FS

OP -> UI : Abrir agendamentos do dia
PL -> OP : Apresenta QR (papel / app)
OP -> UI : Ler QR
UI -> VM : identificar(token)
VM -> CF : call identificarPessoa(token)
CF -> FS : credenciais/{token} → pessoa, agregado
CF -> FS : registar acesso (auditoria)
CF --> VM : pessoa, agregado (código, n.º de pessoas),\nautorizado, restrições, alergias, agendamento do dia
alt pessoa não autorizada ou agregado inativo
  VM --> UI : erro "Não autorizado"
  UI --> OP : mostrar motivo
else autorizada
  VM -> FS : query lotes disponíveis e não expirados\norderBy(congeladoInterno, validade)
  FS --> VM : lotes FEFO
  VM --> UI : sugestão de produtos
  loop produtos do cabaz
    OP -> UI : adicionar lote + quantidade
  end
  OP -> UI : Confirmar entrega
  UI -> VM : confirmar()
  VM -> CF : call registarEntrega(dto)
  activate CF
  CF -> FS : runTransaction: verificar stock e validade,\nabater lotes, criar movimentos SAIDA_CABAZ,\ncriar entrega, agendamento = ENTREGUE,\ncriar próximo agendamento (id determinístico)
  FS --> CF : commit OK
  CF --> VM : entregaId
  deactivate CF
  VM --> UI : sucesso
end
@enduml
